---
import '../styles/dc2sc.css';
import SkipToContent from '../components/site/SkipToContent.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SearchOverlay from '../components/site/SearchOverlay.astro';
import { translations } from '../lib/translations';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'DC2SC — Research on buyer-side market formation',
} = Astro.props;
---
<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} — DC2SC</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&family=Space+Mono:wght@400;700&family=Work+Sans:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" crossorigin="anonymous"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js" crossorigin="anonymous" onload="renderMathInElement(document.body, { delimiters: [ {left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}, {left: '\\(', right: '\\)', display: false}, {left: '\\[', right: '\\]', display: true} ] });"></script>
</head>
<body>
  <div id="page-top" aria-hidden="true" style="position:absolute;top:0;left:0;width:1px;height:1px;"></div>
  <SkipToContent />
  <SiteHeader />
  <main id="main-content" tabindex="-1" data-pagefind-body>
    <slot />
  </main>
  <SiteFooter />
  <SearchOverlay />

  <script is:inline define:vars={{ translationsData: translations }}>
    window.__dcTranslations = translationsData;

    window.__dcApplyLanguage = function(lang) {
      if (!window.__dcTranslations) return;
      const dict = window.__dcTranslations;
      const targetLang = (lang === 'uk' || lang === 'de' || lang === 'en') ? lang : 'uk';

      document.documentElement.lang = targetLang;

      // Update all elements with data-i18n
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (key && dict[key] && dict[key][targetLang]) {
          const val = dict[key][targetLang];
          if (val.includes('<') && val.includes('>')) {
            el.innerHTML = val;
          } else {
            el.innerText = val;
          }
        }
      });

      // Update language selector badge
      const langLabel = document.getElementById('dc-lang-current-label');
      if (langLabel) langLabel.innerText = targetLang.toUpperCase();

      // Update active option state
      document.querySelectorAll('.dc-lang-select__option').forEach((opt) => {
        const optLang = opt.getAttribute('data-lang');
        if (optLang === targetLang) {
          opt.classList.add('dc-lang-select__option--active');
          opt.setAttribute('aria-selected', 'true');
        } else {
          opt.classList.remove('dc-lang-select__option--active');
          opt.setAttribute('aria-selected', 'false');
        }
      });
    };

    (function() {
      let saved = 'uk';
      try {
        saved = localStorage.getItem('dc2sc_locale') || 'uk';
      } catch (e) {}

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => window.__dcApplyLanguage(saved));
      } else {
        window.__dcApplyLanguage(saved);
      }
    })();
  </script>
</body>
</html>
