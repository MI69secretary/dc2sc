---
import fs from 'node:fs';
import path from 'node:path';

const signalsDir = path.join(process.cwd(), 'src/content/signals');
let signals: any[] = [];

if (fs.existsSync(signalsDir)) {
  const files = fs.readdirSync(signalsDir).filter(f => f.endsWith('.json'));
  for (const file of files) {
    try {
      const content = JSON.parse(fs.readFileSync(path.join(signalsDir, file), 'utf-8'));
      signals.push({ slug: file.replace('.json', ''), ...content });
    } catch (e) {}
  }
}

// Map platform to colors and icons
const platformBadges: Record<string, { label: string, color: string, bg: string, icon: string }> = {
  substack: { label: 'Substack', color: '#ea580c', bg: '#fff7ed', icon: '📝' },
  twitter: { label: 'X / Twitter', color: '#0f172a', bg: '#f1f5f9', icon: '𝕏' },
  arxiv: { label: 'arXiv Pre-print', color: '#b91c1c', bg: '#fef2f2', icon: '📄' },
  medium: { label: 'Medium', color: '#047857', bg: '#ecfdf5', icon: '✍️' },
  blog: { label: 'Academic Blog', color: '#1e3a8a', bg: '#eff6ff', icon: '🌐' },
};
---

<section class="dc-section dc-signals-stream-section" style="background: var(--dc-surface); border-top: 2px solid var(--dc-ink); border-bottom: 2px solid var(--dc-ink); padding: 3.5rem 0;">
  <div class="dc-container">
    
    <!-- HEADER -->
    <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1.5rem; margin-bottom: 2rem;">
      <div>
        <div class="dc-eyebrow" style="color: var(--dc-navy); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;" data-i18n="signals.eyebrow">
          <span style="display: inline-block; width: 8px; height: 8px; background: var(--dc-signal); border-radius: 50%; animation: pulse 2s infinite;"></span>
          PERPLEXITY & AI CURATED SIGNALS // ЧЕРГА РЕПУБЛІКАЦІЇ
        </div>
        <h2 class="dc-display-lg" style="font-size: clamp(1.6rem, 3.5vw, 2.25rem); margin: 0; line-height: 1.15;" data-i18n="signals.title">
          Свіжі сигнали, твіти та статті про ринкову координацію
        </h2>
        <p class="dc-body" style="color: var(--dc-ink-2); margin-top: 0.5rem; max-width: 65ch;" data-i18n="signals.lead">
          Автоматичний моніторинг Perplexity AI та кураторський відбір публікацій із Substack, X/Twitter та arXiv, що проходять перевірку на відповідність канонічним модулям DC2SC.
        </p>
      </div>

      <!-- FILTER CONTROLS -->
      <div class="dc-signals-filter-bar" style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
        <button class="dc-filter-btn dc-filter-btn--active" data-platform="all" data-i18n="signals.filter.all">Всі сигнали ({signals.length})</button>
        <button class="dc-filter-btn" data-platform="substack">Substack</button>
        <button class="dc-filter-btn" data-platform="twitter">X / Twitter</button>
        <button class="dc-filter-btn" data-platform="arxiv">arXiv</button>
        <button class="dc-filter-btn" data-platform="medium">Medium</button>
      </div>
    </div>

    <!-- HORIZONTAL SCROLL / CAROUSEL TRACK -->
    <div class="dc-signals-track" id="signals-track">
      {signals.map((sig) => {
        const plat = platformBadges[sig.sourcePlatform] || platformBadges.blog;
        return (
          <article class="dc-signal-card" data-platform={sig.sourcePlatform}>
            
            <!-- CARD TOP: Platform & Module -->
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
              <span class="dc-pill" style={`background: ${plat.bg}; color: ${plat.color}; border-color: ${plat.color}; font-weight: 700; font-size: 0.6875rem;`}>
                {plat.icon} {plat.label}
              </span>
              {sig.relatedModule && (
                <span class="dc-pill dc-pill--accent" style="font-size: 0.625rem;">
                  Модуль 0{sig.relatedModule}
                </span>
              )}
            </div>

            <!-- AUTHOR & DATE -->
            <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; margin-bottom: 0.5rem;">
              <span style="font-family: var(--dc-font-body); font-weight: 700; font-size: 0.8125rem; color: var(--dc-ink);">
                {sig.author}
              </span>
              <span style="font-family: var(--dc-font-mono); font-size: 0.6875rem; color: var(--dc-muted);">
                {sig.publishedDate}
              </span>
            </div>

            <!-- TITLE -->
            <h3 style="font-family: var(--dc-font-display); font-size: 1.0625rem; line-height: 1.3; color: var(--dc-ink); margin-bottom: 0.75rem;">
              <a href={sig.originalUrl} target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: inherit;" class="dc-signal-title-link">
                {sig.title}
              </a>
            </h3>

            <!-- KEY QUOTE HIGHLIGHT BOX -->
            <div style="background: var(--dc-white); border-left: 3px solid var(--dc-navy); padding: 0.75rem 1rem; margin-bottom: 0.75rem; font-size: 0.8125rem; font-style: italic; color: var(--dc-ink-2); line-height: 1.5;">
              {sig.keyQuote}
            </div>

            <!-- SUMMARY -->
            <p style="font-size: 0.8125rem; color: var(--dc-ink-2); line-height: 1.5; margin-bottom: 1rem; flex: 1;">
              {sig.summary}
            </p>

            <!-- TAGS -->
            {sig.curatorTags && (
              <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; margin-bottom: 1rem;">
                {sig.curatorTags.map((tag: string) => (
                  <span style="font-family: var(--dc-font-mono); font-size: 0.625rem; background: var(--dc-surface); border: 1px solid var(--dc-border); padding: 0.15rem 0.4rem; color: var(--dc-muted);">
                    #{tag}
                  </span>
                ))}
              </div>
            )}

            <!-- CARD FOOTER: Action & Status -->
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--dc-border); padding-top: 0.75rem; margin-top: auto;">
              <a href={sig.originalUrl} target="_blank" rel="noopener noreferrer" class="dc-btn dc-btn--ghost" style="padding: 0.4rem 0.75rem; font-size: 0.75rem; text-decoration: none;">
                Читати першоджерело ↗
              </a>
              <span class="dc-pill dc-pill--in-progress" style="font-size: 0.625rem;">
                Черга: Схвалено ✓
              </span>
            </div>

          </article>
        );
      })}
    </div>

    <!-- INGESTION CTA FOOTER -->
    <div style="margin-top: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; border-top: 1px dashed var(--dc-border); padding-top: 1rem;">
      <span style="font-family: var(--dc-font-mono); font-size: 0.75rem; color: var(--dc-muted);">
        🤖 Джерело: Автоматичний агент Perplexity AI + Editorial Inbox у Keystatic CMS
      </span>
      <a href="/admin" class="dc-btn dc-btn--ghost" style="font-size: 0.75rem; padding: 0.35rem 0.75rem;">
        ⚙️ Управління чергою републікації в Адмінці →
      </a>
    </div>

  </div>
</section>

<style>
  .dc-signals-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .dc-signals-track::-webkit-scrollbar {
    height: 6px;
  }
  .dc-signals-track::-webkit-scrollbar-track {
    background: var(--dc-raised);
  }
  .dc-signals-track::-webkit-scrollbar-thumb {
    background: var(--dc-border);
    border-radius: 3px;
  }
  .dc-signals-track::-webkit-scrollbar-thumb:hover {
    background: var(--dc-navy);
  }
  .dc-signal-card {
    flex: 0 0 380px;
    max-width: 380px;
    background: var(--dc-raised);
    border: 2px solid var(--dc-border);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  @media (max-width: 640px) {
    .dc-signal-card {
      flex: 0 0 85vw;
      max-width: 85vw;
      padding: 1.25rem;
    }
  }
  .dc-signal-card:hover {
    border-color: var(--dc-navy);
    transform: translateY(-2px);
  }
  .dc-signal-title-link:hover {
    color: var(--dc-navy);
    text-decoration: underline;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.2); }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.dc-signals-filter-bar button');
    const cards = document.querySelectorAll('.dc-signal-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('dc-filter-btn--active'));
        btn.classList.add('dc-filter-btn--active');

        const plat = btn.getAttribute('data-platform');
        cards.forEach(card => {
          if (plat === 'all' || card.getAttribute('data-platform') === plat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
