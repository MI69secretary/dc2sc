---
import Container from '../site/Container.astro'
import Section from '../site/Section.astro'
import SectionHeading from '../site/SectionHeading.astro'
import Pill from '../site/Pill.astro'
import { activityCategories } from '../../data/announcements.ts'
---

<Section>
  <Container>
    <SectionHeading headline="Research activity" />
    
    <p class="dc-label" style="margin-top: 1.5rem; margin-bottom: 3rem; color: var(--dc-muted);">
      No dates are published in this prototype. No live claims are made.
    </p>
    
    <ul style="list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--dc-border);">
      {activityCategories.map((cat) => (
        <li style="border-bottom: 1px solid var(--dc-border); padding: 1.5rem 0; display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 250px;">
            <strong style="font-family: 'Space Grotesk', sans-serif; font-size: 1.125rem; display: block; margin-bottom: 0.25rem;">
              {cat.label}
            </strong>
            <span style="color: var(--dc-text-secondary); font-size: 0.9375rem;">
              {cat.description}
            </span>
          </div>
          <div>
            <Pill variant="conceptual" text={cat.statusChip} />
          </div>
        </li>
      ))}
    </ul>
  </Container>
</Section>
