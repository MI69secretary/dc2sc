---
interface RelatedItem { type: 'journal' | 'research' | 'goliaf'; title: string; url: string; }
interface Props { items: RelatedItem[]; headline?: string; }
const { items, headline = 'Related content' } = Astro.props;
---
{items.length > 0 && (
  <aside class="dc-related-section">
    <h2 class="dc-eyebrow" style="margin-bottom: 1.5rem;">{headline}</h2>
    <div class="dc-related-grid">
      {items.map(item => (
        <a href={item.url} class="dc-related-card">
          <span class="dc-related-card__type">{item.type}</span>
          <span class="dc-related-card__title">{item.title}</span>
        </a>
      ))}
    </div>
  </aside>
)}
