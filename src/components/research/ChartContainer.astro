---
interface Props {
  chartId: string;
  title?: string;
  dataSource?: string;
  evidenceLevel?: string;
}

const {
  chartId,
  title,
  dataSource,
  evidenceLevel = 'E0',
} = Astro.props;
---

<div class="dc-typed-media-container dc-chart-container" data-chart-id={chartId}>
  <div class="dc-media-passport-header">
    <div class="dc-media-passport-badges">
      <span class="dc-pill dc-pill--accent">{chartId}</span>
      <span class="dc-pill dc-pill--conceptual">ANALYTICAL DATA CHART</span>
      <span class="dc-pill dc-pill--default">{evidenceLevel}</span>
    </div>
  </div>

  {title && <h3 class="dc-chart-title">{title}</h3>}

  <div class="dc-chart-body">
    <slot />
  </div>

  {dataSource && (
    <div class="dc-media-caption">
      <p class="dc-caption-text"><strong>Data Source & Method:</strong> {dataSource}</p>
      <p class="dc-accessible-description">Fail-closed boundary: Analytical model illustration only. No invented empirical data.</p>
    </div>
  )}
</div>

<style>
  .dc-typed-media-container {
    margin: 2.5rem 0;
    border: 1px solid var(--dc-border);
    background: var(--dc-white);
    padding: 1.5rem;
  }
  .dc-media-passport-header {
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--dc-border);
  }
  .dc-media-passport-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .dc-chart-title {
    font-family: var(--dc-font-display);
    font-size: var(--dc-text-h3);
    margin-bottom: 1rem;
    color: var(--dc-ink);
  }
  .dc-chart-body {
    padding: 1.5rem 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background: var(--dc-surface);
    border: 1px solid var(--dc-border);
  }
  .dc-media-caption {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--dc-border);
    font-size: var(--dc-text-body-sm);
    color: var(--dc-ink-2);
  }
  .dc-accessible-description {
    font-size: 0.8125rem;
    color: var(--dc-muted);
  }
</style>
