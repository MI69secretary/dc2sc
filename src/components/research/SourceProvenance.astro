---
import { repositorySourceManifest, type RepositorySourceManifestItem } from '../../data/repository-source-manifest';

interface Props {
  id: string;
  manifestItem?: RepositorySourceManifestItem;
  webAdaptationNotes?: string;
  sourceOfTruth?: string;
}

const { id, manifestItem: propManifest, webAdaptationNotes, sourceOfTruth = 'DC2SC research repository' } = Astro.props;
const manifest = propManifest || repositorySourceManifest[id];

const sourceArtifactId = manifest?.sourceArtifactId || 'DC2SC-CANON-REF';
const sourceArtifactTitle = manifest?.sourceArtifactTitle || 'Canonical Repository Document';
const sourceVersion = manifest?.sourceVersion || '1.0';
const sourceCanonicalState = (manifest?.sourceCanonicalState || 'frozen').toUpperCase();
const sourceEvidenceLevel = manifest?.sourceEvidenceLevel || 'E0';
const sourceStatus = manifest?.sourceLifecycleStatus?.replace(/_/g, ' ') || 'Approved for public reference';
const provenanceType = manifest?.provenanceType?.replace(/_/g, ' ') || 'Canonical import';
const reviewStatus = manifest?.sourceReviewStatus || 'partial';
const sourceReviewDisplay = reviewStatus === 'verified'
  ? 'Verified against approved repository source.'
  : 'Web provenance record established. External repository synchronization not independently verified in this environment.';
const adaptationNote = webAdaptationNotes || manifest?.webAdaptationNote || 'This page is structured for web reading. Its evidence level, scope boundary and substantive claims have not been strengthened by this adaptation.';
---

<div class="dc-provenance-box">
  <div class="dc-provenance-box__header">
    <span class="dc-provenance-box__title">Source Provenance & Authority</span>
    <span class="dc-provenance-box__badge">{provenanceType}</span>
  </div>
  
  <div class="dc-provenance-box__grid">
    <div class="dc-provenance-box__row">
      <span class="dc-provenance-box__key">Source of Truth</span>
      <span class="dc-provenance-box__val">{sourceOfTruth}</span>
    </div>
    <div class="dc-provenance-box__row">
      <span class="dc-provenance-box__key">Source Artifact</span>
      <span class="dc-provenance-box__val"><code>{sourceArtifactId}</code> — {sourceArtifactTitle} (v{sourceVersion})</span>
    </div>
    <div class="dc-provenance-box__row">
      <span class="dc-provenance-box__key">Canon Authority</span>
      <span class="dc-provenance-box__val" style="font-weight: 700; color: var(--dc-accent);">{sourceCanonicalState} · {sourceEvidenceLevel} Conceptual</span>
    </div>
    <div class="dc-provenance-box__row">
      <span class="dc-provenance-box__key">Repository Path</span>
      <span class="dc-provenance-box__val" style="color: var(--dc-muted);">Repository path: Not displayed publicly</span>
    </div>
    <div class="dc-provenance-box__row">
      <span class="dc-provenance-box__key">Source Review</span>
      <span class="dc-provenance-box__val">{sourceReviewDisplay}</span>
    </div>
    <div class="dc-provenance-box__row">
      <span class="dc-provenance-box__key">Lifecycle</span>
      <span class="dc-provenance-box__val" style="text-transform: capitalize;">{sourceStatus}</span>
    </div>
  </div>

  <div class="dc-provenance-box__adaptation">
    <strong>Web adaptation note:</strong>
    <p>{adaptationNote}</p>
  </div>
</div>

<style is:global>
.dc-provenance-box {
  border: 2px solid var(--dc-border);
  background: var(--dc-raised);
  margin-top: 2.5rem;
  margin-bottom: 2rem;
}
.dc-provenance-box__header {
  background: var(--dc-ink);
  color: var(--dc-surface);
  padding: 0.625rem 1.25rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--dc-font-mono);
  font-size: var(--dc-text-mono);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.dc-provenance-box__badge {
  font-size: 0.6875rem;
  padding: 0.15rem 0.5rem;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 2px;
}
.dc-provenance-box__grid {
  padding: 1.25rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}
.dc-provenance-box__row {
  display: grid;
  grid-template-columns: 16ch 1fr;
  gap: 1rem;
  align-items: baseline;
  font-size: var(--dc-text-body-sm);
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  padding-bottom: 0.5rem;
}
.dc-provenance-box__row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.dc-provenance-box__key {
  font-family: var(--dc-font-mono);
  font-size: var(--dc-text-mono);
  color: var(--dc-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.dc-provenance-box__val {
  color: var(--dc-ink);
}
.dc-provenance-box__adaptation {
  border-top: 1px solid var(--dc-border);
  background: var(--dc-white);
  padding: 1rem 1.5rem;
  font-size: var(--dc-text-body-sm);
  color: var(--dc-ink-2);
}
.dc-provenance-box__adaptation strong {
  display: block;
  font-family: var(--dc-font-mono);
  font-size: var(--dc-text-mono);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--dc-muted);
  margin-bottom: 0.25rem;
}
.dc-provenance-box__adaptation p {
  margin: 0;
  line-height: 1.5;
}

@media (max-width: 640px) {
  .dc-provenance-box__row {
    grid-template-columns: 1fr;
    gap: 0.25rem;
  }
}
</style>