---
import { module01CanvasData } from '../../data/canvases/module-01';
import ResearchCanvas from './ResearchCanvas.astro';
import ConceptualDiagram from './ConceptualDiagram.astro';
import ArgumentTable from './ArgumentTable.astro';
import TensionMatrix from './TensionMatrix.astro';
import IllustrativeScenario from './IllustrativeScenario.astro';
import MethodNote from './MethodNote.astro';
import CanvasHandoff from './CanvasHandoff.astro';
import ResearchCanvasMediaRail from './ResearchCanvasMediaRail.astro';

const d = module01CanvasData;

// Transform argument table data to columns and rows
const tableColumns = [
  { header: d.argumentTable.data.leftColumn?.header || 'What the market may see', key: 'market' },
  { header: d.argumentTable.data.rightColumn?.header || 'What a person may carry', key: 'person' },
];

const maxRows = Math.max(
  d.argumentTable.data.leftColumn?.items?.length || 0,
  d.argumentTable.data.rightColumn?.items?.length || 0
);

const tableRows = Array.from({ length: maxRows }, (_, idx) => ({
  market: d.argumentTable.data.leftColumn?.items[idx] || '',
  person: d.argumentTable.data.rightColumn?.items[idx] || '',
}));

const tensionItems = [
  {
    dimension: 'Definition',
    leftValue: d.distinction.choiceText,
    rightValue: d.distinction.voiceText,
  },
  {
    dimension: 'Participant Role',
    leftValue: 'Price-taker selecting among unilateral terms.',
    rightValue: 'Originator or ratifier of collective term proposals.',
  },
  {
    dimension: 'Market Impact',
    leftValue: 'Signals aggregate into demand elasticity and price yield curves.',
    rightValue: 'Position forms bounded commitments conditioning supplier response.',
  },
];
---

<ResearchCanvas
  title={d.manifest.title}
  subtitle={d.manifest.subtitle}
  moduleNumber={d.manifest.moduleNumber}
  evidenceLevel={d.manifest.evidenceLevel}
  canonicalState="frozen"
  claimState="active"
  researchRole="analytical_framework"
  sourceOfTruth="Google Drive Repository (DC2SC-MOD-01)"
  limitations={d.manifest.limitations}
  whatThisDoesNotEstablish={d.manifest.whatThisDoesNotEstablish}
>
  <div class="dc-module01-canvas-demo">
    <!-- SECTION 1: HERO VISUAL (A) -->
    <ResearchCanvasMediaRail width="wide">
      <ConceptualDiagram
        passport={d.hero.passport}
        figureNumber="1.1"
        textSequence={[
          'Independent participants formulate uncoordinated search queries across distinct sessions.',
          'Queries are routed directly to siloed, supplier-defined offer surfaces.',
          'Contextual overlap across participant constraints remains unrepresented and unaggregated.',
          'No collective agency or demand-side counter-proposal is formed.'
        ]}
      >
        <div class="dc-diagram-signals-container" style="background: var(--dc-raised); border: 1px solid var(--dc-border); padding: 2rem; display: flex; flex-direction: column; gap: 1.5rem; align-items: center;">
          <svg viewBox="0 0 800 360" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" style="max-width: 760px; font-family: var(--dc-font-body);">
            <defs>
              <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--dc-accent)" />
              </marker>
            </defs>

            <!-- PARTICIPANT SIGNALS COLUMN -->
            <g id="participants">
              <rect x="30" y="30" width="200" height="300" fill="var(--dc-white)" stroke="var(--dc-border)" stroke-width="1.5" />
              <text x="50" y="60" font-family="var(--dc-font-display)" font-size="14" fill="var(--dc-ink)">INDIVIDUAL SEARCHES</text>
              <text x="50" y="78" font-family="var(--dc-font-mono)" font-size="11" fill="var(--dc-muted)">Isolated sessions</text>

              <!-- Participant 1 -->
              <circle cx="65" cy="115" r="14" fill="var(--dc-surface)" stroke="var(--dc-ink)" stroke-width="1.5" />
              <text x="58" y="120" font-family="var(--dc-font-mono)" font-size="12" font-weight="700">P1</text>
              <text x="90" y="112" font-size="12" font-weight="600" fill="var(--dc-ink)">Signal: dates + budget</text>
              <text x="90" y="128" font-family="var(--dc-font-mono)" font-size="10" fill="var(--dc-muted)">Unshared intent</text>

              <!-- Participant 2 -->
              <circle cx="65" cy="180" r="14" fill="var(--dc-surface)" stroke="var(--dc-ink)" stroke-width="1.5" />
              <text x="58" y="185" font-family="var(--dc-font-mono)" font-size="12" font-weight="700">P2</text>
              <text x="90" y="177" font-size="12" font-weight="600" fill="var(--dc-ink)">Signal: location + risk</text>
              <text x="90" y="193" font-family="var(--dc-font-mono)" font-size="10" fill="var(--dc-muted)">Overlapping dates</text>

              <!-- Participant 3 -->
              <circle cx="65" cy="245" r="14" fill="var(--dc-surface)" stroke="var(--dc-ink)" stroke-width="1.5" />
              <text x="58" y="250" font-family="var(--dc-font-mono)" font-size="12" font-weight="700">P3</text>
              <text x="90" y="242" font-size="12" font-weight="600" fill="var(--dc-ink)">Signal: family constraints</text>
              <text x="90" y="258" font-family="var(--dc-font-mono)" font-size="10" fill="var(--dc-muted)">Isolated inquiry</text>
            </g>

            <!-- DISPERSION ARROWS (ISOLATED PATHWAYS) -->
            <g id="pathways" stroke="var(--dc-accent)" stroke-width="2" fill="none">
              <path d="M 230 115 C 340 115, 380 90, 530 90" marker-end="url(#arrow)" />
              <path d="M 230 180 C 340 180, 380 180, 530 180" marker-end="url(#arrow)" />
              <path d="M 230 245 C 340 245, 380 270, 530 270" marker-end="url(#arrow)" />
            </g>

            <!-- SILOED SUPPLIER OFFERS -->
            <g id="suppliers">
              <rect x="540" y="30" width="230" height="300" fill="var(--dc-white)" stroke="var(--dc-border)" stroke-width="1.5" />
              <text x="560" y="60" font-family="var(--dc-font-display)" font-size="14" fill="var(--dc-ink)">SUPPLIER OFFER SURFACES</text>
              <text x="560" y="78" font-family="var(--dc-font-mono)" font-size="11" fill="var(--dc-muted)">Take-it-or-leave-it inventory</text>

              <rect x="560" y="100" width="190" height="45" fill="var(--dc-surface)" stroke="var(--dc-border)" />
              <text x="575" y="125" font-size="12" font-weight="600" fill="var(--dc-ink)">Standard Non-Refundable S1</text>
              <text x="575" y="137" font-family="var(--dc-font-mono)" font-size="9" fill="var(--dc-muted)">Zero modification voice</text>

              <rect x="560" y="160" width="190" height="45" fill="var(--dc-surface)" stroke="var(--dc-border)" />
              <text x="575" y="185" font-size="12" font-weight="600" fill="var(--dc-ink)">Dynamic Yield Tier S2</text>
              <text x="575" y="197" font-family="var(--dc-font-mono)" font-size="9" fill="var(--dc-muted)">Algorithmically extracted margin</text>

              <rect x="560" y="220" width="190" height="45" fill="var(--dc-surface)" stroke="var(--dc-border)" />
              <text x="575" y="245" font-size="12" font-weight="600" fill="var(--dc-ink)">Bundled Premium Tier S3</text>
              <text x="575" y="257" font-family="var(--dc-font-mono)" font-size="9" fill="var(--dc-muted)">Inelastic constraint capture</text>
            </g>

            <!-- MISSING DEMAND FORMATION CORE -->
            <g id="missing-core">
              <rect x="300" y="120" width="180" height="120" fill="var(--dc-surface)" stroke="var(--dc-border)" stroke-dasharray="4 4" />
              <text x="320" y="155" font-family="var(--dc-font-display)" font-size="11" fill="var(--dc-muted)">MISSING LAYER</text>
              <text x="320" y="175" font-size="11" font-weight="600" fill="var(--dc-error)">No Demand Position</text>
              <text x="320" y="195" font-family="var(--dc-font-mono)" font-size="9" fill="var(--dc-muted)">Signals evaporate into</text>
              <text x="320" y="208" font-family="var(--dc-font-mono)" font-size="9" fill="var(--dc-muted)">unaggregated choice noise</text>
            </g>
          </svg>
        </div>
      </ConceptualDiagram>
    </ResearchCanvasMediaRail>

    <!-- SECTION 2: CORE DISTINCTION TENSION MATRIX (B) -->
    <ResearchCanvasMediaRail width="regular">
      <TensionMatrix
        passport={d.distinction.passport}
        figureNumber="1.2"
        leftTitle={d.distinction.choiceLabel}
        rightTitle={d.distinction.voiceLabel}
        items={tensionItems}
      />
    </ResearchCanvasMediaRail>

    <!-- SECTION 3: WHAT MARKET SEES VS WHAT PERSON CARRIES (C) -->
    <ResearchCanvasMediaRail width="regular">
      <ArgumentTable
        passport={d.argumentTable.passport}
        figureNumber="1.3"
        columns={tableColumns}
        rows={tableRows}
      />
    </ResearchCanvasMediaRail>

    <!-- SECTION 4: INDIVIDUAL DECISION JOURNEY MAP (D) -->
    <ResearchCanvasMediaRail width="wide">
      <IllustrativeScenario
        passport={d.journey.passport}
        figureNumber="1.4"
        steps={d.journey.steps}
      />
    </ResearchCanvasMediaRail>

    <!-- SECTION 5: METHOD NOTE & BOUNDARY DISCLOSURE (E) -->
    <ResearchCanvasMediaRail width="regular">
      <MethodNote
        passport={d.boundaryDisclosure.passport}
        figureNumber="1.5"
        methodType="E0_CONCEPTUAL_FRAMEWORK"
        epistemicCaveat="This research model defines conceptual categories and analytical stress-test conditions. It does not present empirical market conversion metrics or field efficacy guarantees."
      >
        <div class="dc-boundary-content" style="margin-top: 1rem; font-size: var(--dc-text-body-sm); color: var(--dc-ink-2); line-height: 1.6;">
          <p><strong>Boundary Statement:</strong> {d.boundaryDisclosure.text}</p>
        </div>
      </MethodNote>
    </ResearchCanvasMediaRail>

    <!-- SECTION 6: DOWNSTREAM RESEARCH HANDOFF (F) -->
    <ResearchCanvasMediaRail width="regular">
      <CanvasHandoff
        question={d.handoff.question}
        targetModuleTitle={d.handoff.targetModule}
        targetModuleUrl={d.handoff.targetUrl}
        targetModuleNumber={d.handoff.targetModuleNumber}
        passport={d.handoff.passport}
      />
    </ResearchCanvasMediaRail>
  </div>
</ResearchCanvas>