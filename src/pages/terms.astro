---
import SiteShell from '../layouts/SiteShell.astro'
import Container from '../components/site/Container.astro'
import Callout from '../components/site/Callout.astro'
---

<SiteShell title="Terms" description="Terms of service">

  <div class="dc-page-hero">
    <Container>
      <h1 class="dc-page-hero__headline">Terms</h1>
      <p class="dc-page-hero__body">
        Phase 1 prototype — limited scope terms.
      </p>
    </Container>
  </div>

  <Container class="dc-prose" style="max-width: 800px; padding-top: 3rem; padding-bottom: 6rem;">
    
    <Callout type="boundary">
      These are prototype-scope terms only. Full terms must be prepared before any production launch, commerce or user data collection. This is not legal advice.
    </Callout>

    <div style="margin-top: 3rem;">
      <h2>About this prototype</h2>
      <p>This is a Phase 1 research prototype. No goods or services are offered. No contracts are formed. No user accounts are created.</p>

      <h2>Content status</h2>
      <p>All articles, essays, discussions and research materials published on this prototype are clearly labelled 'Conceptual preview' or 'Demo content'. They do not represent field-validated research, commercial claims or professional advice.</p>

      <h2>GOLIAF</h2>
      <p>GOLIAF content on this site is a research environment description. No travel products, bookings, reservations, discounts or market positions are offered or created through this prototype.</p>

      <h2>Intellectual property</h2>
      <p>Research content on this site is published under [license to be determined]. Contact information for permissions requests will be published when the research program establishes its formal publication framework.</p>

      <h2>Liability</h2>
      <p>This prototype is published for research communication purposes. No warranty is given regarding accuracy, completeness or fitness for purpose.</p>

      <h2>Changes to these terms</h2>
      <p>Terms will be updated before any production launch, commerce or user data collection. Updates will be disclosed.</p>
    </div>

  </Container>

</SiteShell>
