---
import SiteShell from '../../layouts/SiteShell.astro'
import Container from '../../components/site/Container.astro'
import Section from '../../components/site/Section.astro'
import Callout from '../../components/site/Callout.astro'
import EvidenceBadge from '../../components/site/EvidenceBadge.astro'
import ContentStatusBadge from '../../components/site/ContentStatusBadge.astro'
import ReadingProgress from '../../components/site/ReadingProgress.astro'
import ModuleBadge from '../../components/site/ModuleBadge.astro'
import SourceProvenance from '../../components/research/SourceProvenance.astro'
import { validateProvenance } from '../../lib/validate-provenance'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const entries = await getCollection('goliaf', ({ data }) =>
    data.visibility !== 'internal' &&
    data.lifecycleStatus !== 'paused' &&
    data.lifecycleStatus !== 'draft' &&
    data.lifecycleStatus !== 'in_review'
  );

  // Run build-time provenance validation
  validateProvenance(entries.map(e => ({ id: e.id, collection: 'goliaf' as const, data: e.data as any })));

  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Fetch related items if specified
const allResearch = await getCollection('research');
const allGoliaf = await getCollection('goliaf');
const relatedItems = (entry.data.relatedArtifacts || []).map(relId => {
  const r = allResearch.find(x => x.id === relId);
  if (r) return { title: r.data.title, url: `/research/${r.id}`, type: r.data.contentKind.replace(/_/g, ' ') };
  const g = allGoliaf.find(x => x.id === relId);
  if (g) return { title: g.data.title, url: `/goliaf/${g.id}`, type: 'GOLIAF artifact' };
  return null;
}).filter(Boolean);
---

<SiteShell title={entry.data.title} description={entry.data.scope}>
  <ReadingProgress />
  
  <!-- BREADCRUMB -->
  <div style="padding: 1.5rem 0; border-bottom: 1px solid var(--dc-border); background: var(--dc-raised);">
    <Container>
      <nav class="dc-breadcrumb">
        <span class="dc-breadcrumb__item">
          <a href="/goliaf" class="dc-breadcrumb__link">GOLIAF</a>
          <span class="dc-breadcrumb__sep">›</span>
        </span>
        <span class="dc-breadcrumb__current">{entry.data.title}</span>
      </nav>
    </Container>
  </div>
  
  <!-- PAGE HERO -->
  <div class="dc-page-hero">
    <Container>
      <div style="font-family: var(--dc-font-mono); font-size: var(--dc-text-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--dc-muted); margin-bottom: 1.5rem;">
        GOLIAF / Bounded travel research environment
      </div>
      <div style="display:flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.5rem; align-items: center;">
        <ContentStatusBadge status={entry.data.lifecycleStatus || 'approved_for_dev'} />
        <span class="dc-badge" style="background: var(--dc-muted); color: white;">{entry.data.artifactType}</span>
        <EvidenceBadge level={entry.data.evidenceLevel} />
        {entry.data.relatedModules?.map(n => <ModuleBadge moduleNumber={n} />)}
      </div>
      <h1 class="dc-page-hero__headline">{entry.data.title}</h1>
      <p class="dc-page-hero__body">{entry.data.scope}</p>
    </Container>
  </div>
  
  <Section background="white">
    <Container>
      <div class="dc-article-layout">
        <article class="dc-article-main">
          
          <Callout type="boundary" title="Important notice">
            GOLIAF is a bounded travel stress-test environment. It is not presented as a booking service, discount program, travel pool, supplier network, membership, waitlist or proven market mechanism.
          </Callout>

          <!-- CONTENT -->
          <div class="dc-prose-article" style="margin-top: 2rem;">
            <Content />
          </div>

          <!-- SOURCE PROVENANCE LAYER -->
          <SourceProvenance 
            id={entry.id} 
            webAdaptationNotes={entry.data.webAdaptationNotes}
            sourceOfTruth={entry.data.sourceOfTruth}
          />
          
          <!-- LIMITATIONS -->
          {entry.data.limitations && entry.data.limitations.length > 0 && (
            <div style="border-left: 4px solid var(--dc-muted); padding: 1.5rem 2rem; background: var(--dc-raised); margin-top: 2.5rem;">
              <strong style="display: block; font-family: var(--dc-font-mono); font-size: var(--dc-text-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--dc-muted); margin-bottom: 1rem;">Limitations</strong>
              <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                {entry.data.limitations.map(l => <li style="font-size: var(--dc-text-body); color: var(--dc-ink-2);">— {l}</li>)}
              </ul>
            </div>
          )}

          <!-- RELATED CANONICAL MATERIAL -->
          {relatedItems.length > 0 && (
            <div style="margin-top: 2.5rem; border: 1px solid var(--dc-border); background: var(--dc-white); padding: 1.5rem;">
              <h3 style="font-family: var(--dc-font-display); font-size: 1.125rem; margin-bottom: 1rem; color: var(--dc-ink);">Related Canonical & Stress-Test Material</h3>
              <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                {relatedItems.map(item => (
                  <a href={item.url} style="display: flex; justify-content: space-between; align-items: baseline; text-decoration: none; padding: 0.5rem 0.75rem; background: var(--dc-raised); border: 1px solid var(--dc-border);">
                    <span style="font-size: var(--dc-text-body-sm); font-weight: 600; color: var(--dc-ink);">{item.title}</span>
                    <span style="font-family: var(--dc-font-mono); font-size: 0.6875rem; text-transform: uppercase; color: var(--dc-muted);">{item.type}</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div style="margin-top: 3rem;">
            <Callout type="boundary" title="Important notice">
              GOLIAF is a bounded travel stress-test environment. It is not presented as a booking service, discount program, travel pool, supplier network, membership, waitlist or proven market mechanism.
            </Callout>
          </div>
          
          <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--dc-border); display: flex; justify-content: space-between; align-items: center;">
            <a href="/goliaf" class="dc-btn dc-btn--ghost">← Back to GOLIAF</a>
          </div>
        </article>
        
        <aside class="dc-article-sidebar">
          <div class="dc-research-status-panel">
            <div class="dc-research-status-panel__header">Research material</div>
            <div class="dc-research-status-panel__body">
              <div class="dc-research-status-panel__row">
                <span class="dc-research-status-panel__key">Evidence</span>
                <EvidenceBadge level={entry.data.evidenceLevel} />
              </div>
              <div class="dc-research-status-panel__row">
                <span class="dc-research-status-panel__key">Role</span>
                <span class="dc-research-status-panel__val">{entry.data.researchRole.replace(/_/g, ' ')}</span>
              </div>
              <div class="dc-research-status-panel__row">
                <span class="dc-research-status-panel__key">Artifact</span>
                <span class="dc-research-status-panel__val">{entry.data.artifactType.replace(/_/g, ' ')}</span>
              </div>
              <div class="dc-research-status-panel__row">
                <span class="dc-research-status-panel__key">Product</span>
                <span class="dc-research-status-panel__val">None</span>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </Container>
  </Section>
</SiteShell>
