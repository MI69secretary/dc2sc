  function downloadGeneratedSvg() {
    const canvas = document.getElementById('gemini-canvas-container');
    const idBadge = document.getElementById('gemini-generated-media-id');
    const svgCode = canvas?.innerHTML;
    if (!svgCode) {
      alert('Немає згенерованого SVG для скачування!');
      return;
    }
    const blob = new Blob([svgCode], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${idBadge?.innerText || 'diagram'}.svg`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }
  window.downloadGeneratedSvg = downloadGeneratedSvg;

