      '7': 'Academic decision tree illustrating null-result validation. A clean branching path leading to a peaceful, zero-penalty "Do Not Aggregate" terminal node highlighted in emerald green #059669.'
    };

    const generatedPrompt = (promptThemes[mod] || promptThemes['1']) + (promptBox ? ` Context: ${promptBox}` : '');
    if (promptText) promptText.innerText = generatedPrompt;
    if (modal) modal.style.display = 'block';
  }
  window.generateIllustrationPrompt = generateIllustrationPrompt;

  function copyIllustrationPrompt() {
    const promptText = document.getElementById('illustration-prompt-text');
    const btn = document.getElementById('btn-copy-illustration-prompt');
    if (promptText && btn) {
      navigator.clipboard.writeText(promptText.innerText);
      const prev = btn.innerText;
      btn.innerText = 'ПРОМПТ СКОПІЙОВАНО! ✓';
      setTimeout(() => btn.innerText = prev, 2000);
    }
  }
  window.copyIllustrationPrompt = copyIllustrationPrompt;

  document.getElementById('diagram-archetype-select')?.addEventListener('change', updateDiagramLive);

  window.addEventListener('DOMContentLoaded', () => {
    const defaultLatex = presets.pareto.latex;
    const latexEl = document.getElementById('formula-latex');
    if (latexEl && !latexEl.value) {
      latexEl.value = defaultLatex;
    }
    setTimeout(updateFormulaLive, 300);
    setTimeout(updateDiagramLive, 300);
  });
</script>
