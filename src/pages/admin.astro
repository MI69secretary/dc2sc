  async function dispatchPerplexitySignal() {
    const btn = document.getElementById('btn-dispatch-signal');
    const source = document.getElementById('sig-source')?.value || 'Twitter';
    const author = document.getElementById('sig-author')?.value || '@researcher';
    const topic = document.getElementById('sig-topic')?.value || 'Coordination Theory';
    const snippet = document.getElementById('sig-snippet')?.value || '';
    const url = document.getElementById('sig-url')?.value || 'https://x.com';

    if (btn) { btn.disabled = true; btn.innerText = '📡 ОБРОБКА СИГНАЛУ...'; }

    try {
      const res = await fetch('/api/ingest-signal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ source, author, topic, snippet, url })
      });
      const data = await res.json();

      if (data.ok) {
        const queue = document.getElementById('signals-queue-container');
        if (queue) {
          const card = document.createElement('div');
          card.className = 'dc-card';
          card.style.padding = '0.85rem';
          card.style.border = '2px solid #059669';
          card.style.background = '#f0fdf4';
          card.innerHTML = `
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
              <span class="dc-label" style="color: var(--dc-navy); font-weight: 700;">${author} · ${source}</span>
              <span class="dc-pill dc-pill--in-progress" style="font-size: 0.625rem; background: #dcfce7; color: #166534;">SCORE: ${(data.signal.relevanceScore || 0.9).toFixed(2)} // ${data.signal.canonicalModule}</span>
            </div>
            <p style="font-size: 0.8125rem; line-height: 1.4; margin: 0 0 0.5rem; color: var(--dc-ink-2);">
              "${snippet}"
            </p>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <a href="${url}" target="_blank" style="font-size: 0.6875rem; color: var(--dc-navy);">Відкрити першоджерело ↗</a>
              <span class="dc-label" style="font-size: 0.625rem; color: #166534;">✓ JUST INGESTED INTO KEYSTATIC</span>
            </div>
          `;
          queue.insertBefore(card, queue.firstChild);
        }
        alert(`✓ Сигнал успішно оброблено!\nМодуль: ${data.signal.canonicalModule}\nRelevance Score: ${data.signal.relevanceScore}`);
      } else {
        alert('Помилка обробки сигналу: ' + (data.error || 'Unknown error'));
      }
    } catch (err) {
      alert('Помилка мережі при відправці сигналу: ' + err.message);
    } finally {
      if (btn) { btn.disabled = false; btn.innerText = '🚀 НАДІСЛАТИ СИГНАЛ В API (/api/ingest-signal)'; }
    }
  }
  window.dispatchPerplexitySignal = dispatchPerplexitySignal;

