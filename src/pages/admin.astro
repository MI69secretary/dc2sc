  function updateFormulaLive() {
    const title = document.getElementById('formula-title')?.value || '';
    const latex = document.getElementById('formula-latex')?.value || '';
    const vars = document.getElementById('formula-variables')?.value || '';

    const prevTitle = document.getElementById('prev-title');
    const prevMath = document.getElementById('prev-math');
    const prevVars = document.getElementById('prev-vars');
    const snippetEl = document.getElementById('generated-snippet');

    if (prevTitle) prevTitle.innerText = title;
    if (prevVars) prevVars.innerText = vars;

    if (prevMath && window.katex) {
      try {
        window.katex.render(latex, prevMath, {
          displayMode: true,
          throwOnError: false
        });
      } catch (err) {
        prevMath.innerText = latex;
      }
    }

    if (snippetEl) {
      snippetEl.innerText = '{% formula\n   title="' + title + '"\n   latex="' + latex + '"\n   variables="' + vars + '"\n   theoremType="theorem"\n   status="FORMALLY VERIFIED" %}';
    }
  }

  function copyMarkdocSnippet() {
    const snippetEl = document.getElementById('generated-snippet');
    const btn = document.getElementById('btn-copy-markdoc');
    if (snippetEl && btn) {
      navigator.clipboard.writeText(snippetEl.innerText);
      const prev = btn.innerText;
      btn.innerText = 'СКОПІЙОВАНО!';
      setTimeout(() => btn.innerText = prev, 2000);
    }
  }

  document.getElementById('btn-copy-markdoc')?.addEventListener('click', copyMarkdocSnippet);

  document.getElementById('formula-presets')?.addEventListener('change', (e) => {
    const key = e.target.value;
    const p = presets[key];
    if (p) {
      document.getElementById('formula-title').value = p.title;
      document.getElementById('formula-latex').value = p.latex;
      document.getElementById('formula-variables').value = p.vars;
      updateFormulaLive();
    }
  });

  ['formula-title', 'formula-latex', 'formula-variables'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', updateFormulaLive);
  });

