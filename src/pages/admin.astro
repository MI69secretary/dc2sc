    },
    dispersion: {
      title: 'Рівняння 2: Коефіцієнт штучної дисперсії вибору',
      latex: '\\gamma(t) = \\frac{\\sigma_{p}(t)}{\\bar{p}(t)} \\cdot \\log_2 \\left( 1 + \\frac{\\mathcal{H}_{info}}{\\mathcal{H}_{search}} \\right)',
      vars: '\\sigma_p — дисперсія цін; \\bar{p} — середня ціна; \\mathcal{H} — ентропія інформаційного середовища.'
    },
    escrow: {
      title: 'Інваріант 3: Умова стійкості криптографічного ZK-ескроу',
