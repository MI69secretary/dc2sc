---
// admin.astro — DC2SC Administrative Control Plane & LaTeX Formula Hub
import SiteShell from '../layouts/SiteShell.astro';
import Container from '../components/site/Container.astro';
import Section from '../components/site/Section.astro';
import LiveTelemetryBar from '../components/site/LiveTelemetryBar.astro';
import EditorialHero from '../components/editorial/EditorialHero.astro';
import FormulaBlock from '../components/research/FormulaBlock.astro';
import driveManifest from '../data/drive-repository-manifest.json';
---

<SiteShell title="Адміністративна панель управління" description="DC2SC Administrative Control Plane — Keystatic CMS, LaTeX Formula Publishing, and Translation Hub.">
  <LiveTelemetryBar />

  <EditorialHero 
    eyebrow="DC2SC ADMIN & CONTROL PLANE // ПАНЕЛЬ УПРАВЛІННЯ"
    title="Центр управління контентом, LaTeX-формулами та автоперекладами"
    lead="Інтегрована панель для редагування канонічних досліджень у Keystatic CMS, компіляції та перевірки математичних формул у стандарті LaTeX/KaTeX і синхронізації мовних локалей."
    arxivId="ADMIN-CONTROL-V1"
    sha256="ec81a9f0...991c"
  />

  <Section background="white">
    <Container>

      <!-- ADMIN SUB-NAV JUMP BAR -->
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--dc-border);">
        <a href="/keystatic" class="dc-btn dc-btn--primary" target="_blank">📝 Keystatic CMS ↗</a>
        <a href="#gemini-studio" class="dc-btn dc-btn--primary" style="background: linear-gradient(135deg, #1e3a8a, #6366f1); border: none; color: white;">✨ Gemini AI Генератор</a>
        <a href="#formula-lab" class="dc-btn dc-btn--secondary">📐 Пісочниця LaTeX</a>
        <a href="#signals-hub" class="dc-btn dc-btn--secondary" style="background: #ecfdf5; border-color: #059669; color: #059669;">📡 Perplexity & Сигнали</a>
        <a href="#mcp-guide" class="dc-btn dc-btn--secondary" style="background: var(--dc-accent-low); border-color: var(--dc-accent);">🔌 AI & MCP Інтеграція</a>
        <a href="#diagrams-studio" class="dc-btn dc-btn--ghost">📊 diagrams.md & design.md</a>
        <button class="dc-btn dc-btn--ghost" onclick="triggerUpdateAll()">⚡ Оновити все</button>
      </div>

      <!-- 1. QUICK LAUNCH ACTIONS & ONE-CLICK UPDATE SUITE -->
      <div class="dc-grid dc-grid--3" style="margin-bottom: 2rem;">
        
        <div class="dc-card" style="border: 2px solid var(--dc-navy); background: var(--dc-raised); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div class="dc-pill dc-pill--accent" style="margin-bottom: 0.75rem;">CMS CONTROL</div>
            <h3 class="dc-h3">Keystatic CMS</h3>
            <p class="dc-body-sm" style="color: var(--dc-ink-2); margin-top: 0.5rem;">
              Редагування 24 колекцій: модулі досліджень, депеші журналу, гіпотези, автори та протоколи GOLIAF.
            </p>
          </div>
          <div style="margin-top: 1.5rem;">
            <a href="/keystatic" class="dc-btn dc-btn--primary" style="width: 100%; justify-content: center;" target="_blank">
              ВІДКРИТИ KEYSTATIC →
            </a>
          </div>
        </div>

        <div class="dc-card" style="border: 2px solid var(--dc-accent); background: var(--dc-accent-low); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div class="dc-pill dc-pill--accent" style="margin-bottom: 0.75rem; background: var(--dc-white);">ONE-CLICK UPDATE</div>
            <h3 class="dc-h3" style="color: var(--dc-navy);">Оновити PDF та Переклади</h3>
            <p class="dc-body-sm" style="color: var(--dc-ink-2); margin-top: 0.5rem;">
              Генерація PDF-видань для всіх 7 модулів, оновлення мовних локалей (`uk`, `en`, `de`) та перерахунок Drive маніфесту.
            </p>
          </div>
          <div style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
            <button class="dc-btn dc-btn--primary" style="width: 100%; justify-content: center;" id="btn-update-all" onclick="triggerUpdateAll()">
              ⚡ ОНОВИТИ ВСЕ (UPDATE ALL)
            </button>
            <button class="dc-btn dc-btn--ghost" style="width: 100%; justify-content: center; background: var(--dc-white);" id="btn-generate-pdfs" onclick="triggerGeneratePdfs()">
              📄 Тільки згенерувати PDF
            </button>
          </div>
        </div>

        <div class="dc-card" style="border: 2px solid var(--dc-ink); background: var(--dc-raised); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div class="dc-pill dc-pill--default" style="margin-bottom: 0.75rem;">INTEGRITY TELEMETRY</div>
            <h3 class="dc-h3">Репозиторій та Маніфест</h3>
            <p class="dc-body-sm" style="color: var(--dc-ink-2); margin-top: 0.5rem;">
              Файлів у Google Drive маніфесті: <strong>{driveManifest.totalFiles}</strong> ({driveManifest.totalSizeBytes} байт). 
              PDF видань у Git: <strong>7/7 READY</strong>.
            </p>
          </div>
          <div style="margin-top: 1.5rem; display: flex; gap: 0.5rem;">
            <a href="/search-index.json" class="dc-btn dc-btn--ghost" style="flex: 1; justify-content: center;" target="_blank">
              SEARCH INDEX
            </a>
            <a href="/calendar.ics" class="dc-btn dc-btn--ghost" style="flex: 1; justify-content: center;" target="_blank">
              CALENDAR .ICS
            </a>
          </div>
        </div>

      </div>

      <!-- LIVE UPDATE CONSOLE (Hidden by default, shows upon clicking Update) -->
      <div id="admin-update-console" class="dc-card" style="display: none; border: 2px solid var(--dc-accent); background: #0f172a; color: #f8fafc; padding: 1.5rem; margin-bottom: 3rem; font-family: var(--dc-font-mono); font-size: 0.8125rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; border-bottom: 1px solid #334155; padding-bottom: 0.5rem;">
          <span style="color: #38bdf8; font-weight: 700;">● SYSTEM MAINTENANCE LOG</span>
          <span id="console-status-badge" style="color: #4ade80;">RUNNING...</span>
        </div>
        <pre id="console-output" style="margin: 0; white-space: pre-wrap; line-height: 1.5; color: #cbd5e1; max-height: 250px; overflow-y: auto;">Ініціалізація процесу оновлення...</pre>
      </div>

      <!-- 2. INTERACTIVE LATEX FORMULA PLAYGROUND -->
      <div id="formula-lab" class="dc-card" style="border: 2px solid var(--dc-navy); padding: 2.5rem; margin-bottom: 3.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--dc-border); padding-bottom: 1rem;">
          <div>
            <span class="dc-pill dc-pill--accent" style="margin-bottom: 0.5rem; display: inline-block;">LATEX PUBLISHING LAB // ПІСОЧНИЦЯ ФОРМУЛ</span>
            <h2 class="dc-h2" style="margin: 0;">Інтерактивний компілятор та валідатор LaTeX формул</h2>
          </div>
          <span class="dc-label" style="color: var(--dc-signal); font-weight: 700;">● KATEX ACADEMIC ENGINE READY</span>
        </div>

        <p class="dc-body" style="color: var(--dc-ink-2); margin-bottom: 1.5rem;">
          Введіть формулу у форматі LaTeX для миттєвої візуалізації, перевірки синтаксису та копіювання коду тегу Markdoc для вставки у статті.
        </p>

        <div class="dc-grid dc-grid--2" style="gap: 2rem; align-items: start;">
          
          <!-- FORMULA INPUTS -->
          <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div>
              <label for="formula-presets" class="dc-label" style="display: block; margin-bottom: 0.4rem; color: var(--dc-muted);">Пресети академічних інваріантів:</label>
              <select id="formula-presets" class="dc-card" style="width: 100%; padding: 0.6rem; font-family: var(--dc-font-body); font-size: 0.875rem; border: 1px solid var(--dc-border); cursor: pointer;">
                <option value="pareto">Теорема 1: Парето-оптимальність пулу зворотного попиту</option>
                <option value="dispersion">Рівняння 2: Коефіцієнт штучної дисперсії вибору</option>
                <option value="escrow">Інваріант 3: Умова стійкості криптографічного ZK-ескроу</option>
                <option value="entropy">Рівняння 4: Інформаційна ентропія рекомендаційного алгоритму</option>
              </select>
            </div>

            <div>
              <label for="formula-title" class="dc-label" style="display: block; margin-bottom: 0.4rem; color: var(--dc-muted);">Назва теореми / формули:</label>
              <input type="text" id="formula-title" value="Теорема 1: Парето-оптимальність пулу зворотного попиту" class="dc-card" style="width: 100%; padding: 0.6rem; font-family: var(--dc-font-body); font-size: 0.875rem; border: 1px solid var(--dc-border);" />
            </div>

            <div>
              <label for="formula-latex" class="dc-label" style="display: block; margin-bottom: 0.4rem; color: var(--dc-muted);">Код LaTeX:</label>
              <textarea id="formula-latex" rows="4" class="dc-card" style="width: 100%; padding: 0.75rem; font-family: var(--dc-font-mono); font-size: 0.875rem; border: 1px solid var(--dc-border); line-height: 1.5;"></textarea>
            </div>

            <div>
              <label for="formula-variables" class="dc-label" style="display: block; margin-bottom: 0.4rem; color: var(--dc-muted);">Експлікація змінних:</label>
              <input type="text" id="formula-variables" value="V(x) — гранична корисність покупця; p(x) — ціна пулу; MC — граничні витрати; epsilon — мінімальна маржа постачальника." class="dc-card" style="width: 100%; padding: 0.6rem; font-family: var(--dc-font-body); font-size: 0.875rem; border: 1px solid var(--dc-border);" />
            </div>

            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
              <button class="dc-btn dc-btn--primary" id="btn-copy-markdoc">
                СКОПІЮВАТИ MARKDOC ТЕГ
              </button>
            </div>
          </div>

          <!-- LIVE PREVIEW BOX -->
          <div>
            <span class="dc-label" style="display: block; margin-bottom: 0.4rem; color: var(--dc-muted);">Миттєве прев'ю (KaTeX):</span>
            
            <div id="live-formula-preview" class="dc-formula-block" style="margin: 0;">
              <div class="dc-formula-block__header">
                <span class="dc-pill dc-pill--accent" style="font-size: 0.6875rem;" id="prev-badge">ТЕОРЕМА / THEOREM</span>
                <span class="dc-pill dc-pill--in-progress" style="font-size: 0.625rem;">
                  <span class="dc-status-dot" style="margin-right: 4px;"></span>
                  FORMALLY VERIFIED
                </span>
              </div>
              <h4 class="dc-formula-block__title" id="prev-title">Теорема 1: Парето-оптимальність пулу зворотного попиту</h4>
              <div class="dc-formula-block__equation" style="text-align: center;">
                <div id="prev-math" style="overflow-x: auto; padding: 0.5rem 0;"></div>
              </div>
              <div class="dc-formula-block__variables" id="prev-vars-box">
                <span class="dc-label" style="display: block; margin-bottom: 0.35rem; color: var(--dc-muted);">Експлікація змінних:</span>
                <div id="prev-vars" style="font-family: var(--dc-font-mono); font-size: 0.75rem; color: var(--dc-ink-2); line-height: 1.5;">
                  V(x) — гранична корисність покупця; p(x) — ціна пулу; MC — граничні витрати; epsilon — мінімальна маржа постачальника.
                </div>
              </div>
              <div class="dc-formula-block__footer">
                <span>STATUS: READY FOR PUBLICATION</span>
              </div>
            </div>

            <!-- GENERATED MARKDOC CODE SNIPPET -->
            <div style="margin-top: 1.5rem;">
              <span class="dc-label" style="display: block; margin-bottom: 0.4rem; color: var(--dc-muted);">Код для вставки у статтю (.md / .mdoc):</span>
              <pre class="dc-code-schema" style="padding: 1rem; font-size: 0.75rem; color: #a5f3fc; overflow-x: auto;" id="generated-snippet"></pre>
            </div>

          </div>

        </div>
      </div>

      <!-- 3. PRE-COMPILED CANONICAL FORMULAS SHOWCASE -->
      <div style="margin-bottom: 3.5rem;">
        <div class="dc-eyebrow" style="margin-bottom: 0.75rem;">КАНОНІЧНІ МАТЕМАТИЧНІ ІНВАРІАНТИ // SPECIFICATIONS</div>
        <h2 class="dc-display-lg" style="font-size: 1.75rem; margin-bottom: 1.5rem;">Опубліковані математичні докази платформи</h2>

        <FormulaBlock 
          formulaId="INV-01-PARETO"
          title="Теорема 1: Стійкість пулу зворотного попиту за Нешем"
          latex="\\min_{p \\in \\mathcal{P}} \\mathbb{E}[U(p)] = \\int_{\\Omega} \\left( V(x) - p(x) \\right) d\\mu(x) \\ge MC + \\epsilon"
          equationNumber="(Eq. 1.1)"
          theoremType="theorem"
          description="Доводить, що координований пул покупців із сумарною ємністю попиту руйнує монопольну премію та встановлює ціну на рівні конкурентного оптимуму Парето."
          variables="V(x) — гранична оцінка блага; p(x) — скоординована ціна пулу; d\mu(x) — розподіл інтенсивності потреби."
        />

        <FormulaBlock 
          formulaId="INV-02-DISPERSION"
          title="Рівняння 2: Індекс штучної волатильності цін (Dispersion Coefficient)"
          latex="\\gamma(t) = \\frac{\\sigma_{p}(t)}{\\bar{p}(t)} \\cdot \\log_2 \\left( 1 + \\frac{\\mathcal{H}_{info}}{\\mathcal{H}_{search}} \\right)"
          equationNumber="(Eq. 2.4)"
          theoremType="invariant"
          description="Кількісний показник екстракції ренти через штучну зашумленість пошукового простору покупця."
          variables="\sigma_p — дисперсія цінових пропозицій; \mathcal{H}_{info} — ентропія алгоритму; \mathcal{H}_{search} — вартість пошуку."
        />

        <FormulaBlock 
          formulaId="INV-03-ZK-ESCROW"
          title="Лема 3: Кворум ZK-ескроу верифікації зобов'язання"
          latex="\\sum_{i=1}^{N} c_i \\ge \\Theta_{quorum} \\implies \\Pr(\\text{Seller Collusion}) < 2^{-\\lambda}"
          equationNumber="(Eq. 3.2)"
          theoremType="lemma"
          description="Криптографічний захист: при досягненні порогового кворуму \Theta_{quorum} ризик змови продавців експоненційно прямує до нуля."
          variables="c_i — частка депозиту покупця; \Theta — пороговий кворум пулу; \lambda — параметр безпеки криптографічного доказу."
        />
      </div>

      <!-- 4. MODEL CONTEXT PROTOCOL (MCP) AI INTEGRATION SUITE -->
      <div id="mcp-guide" class="dc-card" style="border: 2px solid var(--dc-navy); padding: 2.5rem; margin-bottom: 3.5rem; background: var(--dc-raised);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--dc-border); padding-bottom: 1rem;">
          <div>
            <span class="dc-pill dc-pill--accent" style="margin-bottom: 0.5rem; display: inline-block;">AI & MCP SUITE // ІНТЕГРАЦІЯ З AI</span>
            <h2 class="dc-h2" style="margin: 0;">Підключення Claude, ChatGPT та Cursor через MCP</h2>
          </div>
          <span class="dc-label" style="color: var(--dc-signal); font-weight: 700;">● MCP PROTOCOL v2024-11-05 ACTIVE</span>
        </div>

        <p class="dc-body" style="color: var(--dc-ink-2); margin-bottom: 2rem;">
          Сервер <strong>DC2SC MCP</strong> дозволяє AI-асистентам (Claude Desktop, Claude Code, ChatGPT, Cursor, Windsurf) безпосередньо взаємодіяти з науковим репозиторієм: <strong>читати статті та формули</strong>, <strong>залишати рецензії та зауваження</strong>, <strong>публікувати нові дослідження</strong> та <strong>автоматично генерувати PDF</strong>.
        </p>

        <!-- MCP CLIENTS TABS / GRIDS -->
        <div class="dc-grid dc-grid--3" style="margin-bottom: 2.5rem;">
          
          <!-- CLAUDE DESKTOP -->
          <div class="dc-card" style="border: 1px solid var(--dc-border); background: var(--dc-white); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div class="dc-pill dc-pill--accent" style="margin-bottom: 0.5rem;">CLAUDE DESKTOP</div>
              <h4 style="font-family: var(--dc-font-display); font-size: 1.125rem; margin-bottom: 0.5rem;">Claude Desktop & Code</h4>
              <p class="dc-body-sm" style="color: var(--dc-ink-2); line-height: 1.5;">
                Додайте налаштування у файл конфігурації Claude:
              </p>
              <div style="font-size: 0.6875rem; color: var(--dc-muted); margin: 0.4rem 0; font-family: var(--dc-font-mono);">
                Windows: %APPDATA%\Claude\claude_desktop_config.json<br/>
                macOS: ~/Library/Application Support/Claude/...
              </div>
            </div>
            <div style="margin-top: 1rem;">
              <button class="dc-btn dc-btn--secondary" style="width: 100%; justify-content: center; font-size: 0.75rem;" id="btn-copy-claude-mcp" onclick="copyClaudeMcpConfig()">
                📋 СКОПІЮВАТИ JSON КОНФІГ
              </button>
            </div>
          </div>

          <!-- CURSOR & WINDSURF -->
          <div class="dc-card" style="border: 1px solid var(--dc-border); background: var(--dc-white); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div class="dc-pill dc-pill--default" style="margin-bottom: 0.5rem;">IDE INTEGRATION</div>
              <h4 style="font-family: var(--dc-font-display); font-size: 1.125rem; margin-bottom: 0.5rem;">Cursor & Windsurf</h4>
              <p class="dc-body-sm" style="color: var(--dc-ink-2); line-height: 1.5;">
                1. Відкрийте <code>Settings</code> ➔ <code>Features</code> ➔ <code>MCP</code>.<br/>
                2. Натисніть <strong>Add New MCP Server</strong>.<br/>
                3. Назва: <code>dc2sc-research</code>.<br/>
                4. Команда: <code>node src/mcp/server.mjs</code>.
              </p>
            </div>
            <div style="margin-top: 1rem;">
              <button class="dc-btn dc-btn--ghost" style="width: 100%; justify-content: center; font-size: 0.75rem;" onclick="alert('Шлях до сервера: src/mcp/server.mjs')">
                ℹ️ ПЕРЕВІРИТИ ПАРАМЕТРИ
              </button>
            </div>
          </div>

          <!-- CHATGPT ACTIONS -->
          <div class="dc-card" style="border: 1px solid var(--dc-border); background: var(--dc-white); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div class="dc-pill dc-pill--in-progress" style="margin-bottom: 0.5rem;">REST API & GPTs</div>
              <h4 style="font-family: var(--dc-font-display); font-size: 1.125rem; margin-bottom: 0.5rem;">ChatGPT (Custom GPTs)</h4>
              <p class="dc-body-sm" style="color: var(--dc-ink-2); line-height: 1.5;">
                Використовує вбудовані HTTP REST-ендпоінти:
              </p>
              <ul style="font-size: 0.75rem; color: var(--dc-ink-2); margin-top: 0.4rem; padding-left: 1.2rem;">
                <li><code>POST /api/update-all</code></li>
                <li><code>POST /api/generate-pdfs</code></li>
                <li><code>GET /search-index.json</code></li>
              </ul>
            </div>
            <div style="margin-top: 1rem;">
              <a href="/search-index.json" class="dc-btn dc-btn--ghost" style="width: 100%; justify-content: center; font-size: 0.75rem;" target="_blank">
                ПЕРЕГЛЯНУТИ SEARCH API
              </a>
            </div>
          </div>

        </div>

        <!-- CONFIG JSON PREVIEW BOX -->
        <div style="margin-bottom: 2.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span class="dc-label" style="color: var(--dc-muted);">Вміст файлу claude_desktop_config.json (або dc2sc-mcp-config.json):</span>
            <span class="dc-pill dc-pill--default" style="font-size: 0.625rem;">JSON CONFIG</span>
          </div>
          <pre id="mcp-config-code" style="background: #0f172a; color: #38bdf8; padding: 1.25rem; border: 1px solid #334155; font-family: var(--dc-font-mono); font-size: 0.8125rem; overflow-x: auto; margin: 0; line-height: 1.5;">&#123;
  "mcpServers": &#123;
    "dc2sc-research": &#123;
      "command": "node",
      "args": [
        "C:\\Users\\mytha\\Documents\\Codex\\2026-09-17\\new-chat\\outputs\\dc2sc\\src\\mcp\\server.mjs"
      ]
    &#125;
  &#125;
&#125;</pre>
        </div>

        <!-- MCP TOOLS CATALOG TABLE -->
        <div style="margin-bottom: 2rem;">
          <h3 class="dc-h3" style="margin-bottom: 1rem;">Каталог інструментів MCP (Tools Catalog)</h3>
          <div style="overflow-x: auto;">
            <table class="dc-table" style="width: 100%; border-collapse: collapse; font-size: 0.875rem; text-align: left; background: var(--dc-white);">
              <thead>
                <tr style="background: var(--dc-navy); color: white; border-bottom: 2px solid var(--dc-ink);">
                  <th style="padding: 0.75rem 1rem; font-family: var(--dc-font-mono);">Інструмент</th>
