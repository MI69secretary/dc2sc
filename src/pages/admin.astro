  let currentGeneratedDiagram = null;

  async function generateGeminiDiagram() {
    const btn = document.getElementById('btn-generate-gemini-diagram');
    const apiKey = document.getElementById('gemini-api-key')?.value || '';
    const moduleNumber = parseInt(document.getElementById('gemini-module-select')?.value || '4', 10);
    const diagramType = document.getElementById('gemini-diagram-type')?.value || 'payoff-tree';
    const prompt = document.getElementById('gemini-custom-prompt')?.value || '';

    if (btn) { btn.disabled = true; btn.innerText = '⚡ ГЕНЕРАЦІЯ ВЕКТОРУ (GEMINI AI)...'; }

    try {
      const res = await fetch('/api/generate-diagram', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ apiKey, moduleNumber, diagramType, prompt })
      });
      const data = await res.json();

      if (data.ok && data.diagram) {
        currentGeneratedDiagram = data.diagram;
        
        // Update Canvas Preview
        const canvas = document.getElementById('gemini-canvas-container');
        if (canvas) canvas.innerHTML = data.diagram.svg;

        // Update Media ID Badge
        const idBadge = document.getElementById('gemini-generated-media-id');
        if (idBadge) idBadge.innerText = data.diagram.mediaId;

        // Update Markdoc Snippet
        const snippetEl = document.getElementById('gemini-markdoc-snippet');
        if (snippetEl) snippetEl.innerText = data.diagram.markdoc;

        // Update Passport Preview
        const passportEl = document.getElementById('gemini-passport-preview');
        if (passportEl) passportEl.innerText = JSON.stringify(data.diagram.passport, null, 2);

        alert(`✓ Векторну діаграму ${data.diagram.mediaId} успішно згенеровано!`);
      } else {
        alert('Помилка генерації діаграми: ' + (data.error || 'Unknown error'));
      }
    } catch (err) {
      alert('Помилка мережі при генерації діаграми: ' + err.message);
    } finally {
      if (btn) { btn.disabled = false; btn.innerText = '⚡ ЗГЕНЕРУВАТИ ДІАГРАМУ'; }
    }
  }
  window.generateGeminiDiagram = generateGeminiDiagram;

