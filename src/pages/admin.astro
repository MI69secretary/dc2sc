        if (badgeEl) { badgeEl.style.color = '#4ade80'; badgeEl.innerText = 'УСПІШНО ВИКОНАНО ✓'; }
        if (outputEl) {
          outputEl.innerText = `[${data.timestamp}] ${data.message}\n\n=== PDF ВИДАННЯ ===\n${data.pdfOutput}\n\n=== СИНХРОНІЗАЦІЯ ПЕРЕКЛАДІВ ===\n${data.translationOutput}\n\n=== GOOGLE DRIVE MANIFEST ===\n${data.driveOutput}`;
