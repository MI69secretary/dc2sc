    if (!currentGeneratedDiagram) {
      alert('Спочатку згенеруйте діаграму натиснувши "ЗГЕНЕРУВАТИ ДІАГРАМУ"!');
      return;
    }
    const btn = document.getElementById('btn-save-generated-diagram');
    if (btn) { btn.disabled = true; btn.innerText = '💾 ЗБЕРЕЖЕННЯ...'; }

    try {
      const res = await fetch('/api/save-diagram', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ diagram: currentGeneratedDiagram })
      });
      const data = await res.json();
      if (data.ok) {
        alert(`✓ ${data.message}\nПаспорт: ${data.paths.passportFile}\nSVG: ${data.paths.svgFile}`);
