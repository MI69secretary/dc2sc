# DC2SC Academic Platform — Environment Variables
# Copy this file to .env and configure your credentials

# Application Port (Default: 4321)
PORT=4321
HOST=0.0.0.0

# Google Gemini AI API Key (Optional — for AI vector diagram generation and illustration studio)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Perplexity AI API Key (Optional — for automated background research & signal scraping)
# Get a key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Google Drive Integration (Optional — for automated article sync)
# Folder ID of the shared research papers directory:
GOOGLE_DRIVE_FOLDER_ID=

# Keystatic CMS GitHub Storage Mode (Optional — leave unset for Local File Mode)
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_REPO_OWNER=
# PUBLIC_KEYSTATIC_REPO_NAME=
